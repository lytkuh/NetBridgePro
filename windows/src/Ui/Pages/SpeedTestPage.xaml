<Page x:Class="NetBridge.Windows.Ui.SpeedTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="clr-namespace:NetBridge.Windows.Ui.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="تست سرعت از داخل تونل" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="HintText" Text="" Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock x:Name="DurLabel" Text="مدت هر فاز (ثانیه):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SecondsBox" Width="60" Text="10" />
                        <Button x:Name="RunBtn" Style="{StaticResource PrimaryBtn}" Content="شروع تست" Margin="12,0,0,0" Click="Run_Click" />
                        <Button x:Name="CancelBtn" Content="لغو" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click" />
                        <TextBlock x:Name="PhaseText" Text="" Margin="16,0,0,0" Foreground="{StaticResource Accent2Brush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar x:Name="PhaseBar" Minimum="0" Maximum="100" Margin="0,10,0,0" Value="0" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,5,10">
                    <StackPanel>
                        <TextBlock x:Name="DownLabel" Text="دانلود" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="DownVal" Text="—" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,5,10">
                    <StackPanel>
                        <TextBlock x:Name="UpLabel" Text="آپلود" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="UpVal" Text="—" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,5,10">
                    <StackPanel>
                        <TextBlock x:Name="PingLabel" Text="پینگ" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="PingVal" Text="—" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="JitterLabel" Text="جیتر" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="JitterVal" Text="—" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="LiveTitle" Text="زنده" Style="{StaticResource CardTitle}" />
                    <ctl:SpeedChart x:Name="LiveChart" Height="150" Margin="0,8,0,0" />
                    <Button x:Name="ClearBtn" Content="پاک‌کردن نمودار" Margin="0,10,0,0" HorizontalAlignment="Left" Click="Clear_Click" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
