<Page x:Class="NetBridge.Windows.Ui.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="clr-namespace:NetBridge.Windows.Ui.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Connection -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ConnTitle" Text="وضعیت اتصال" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="Dot" Width="11" Height="11" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnState" Text="قطع" FontSize="17" FontWeight="SemiBold" Margin="8,0,0,0" />
                            <TextBlock x:Name="TransportText" Text="—" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Border Background="{StaticResource Card2Brush}" CornerRadius="7" Padding="9,5" Margin="0,0,7,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="EndpointLabel" Text="مقصد: " Foreground="{StaticResource MutedBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="EndpointText" Text="—" FontSize="11.5" Style="{StaticResource Mono}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card2Brush}" CornerRadius="7" Padding="9,5" Margin="0,0,7,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PhoneLabel" Text="گوشی: " Foreground="{StaticResource MutedBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="PhoneText" Text="—" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card2Brush}" CornerRadius="7" Padding="9,5" Margin="0,0,7,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="BatteryLabel" Text="باتری: " Foreground="{StaticResource MutedBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="BatteryText" Text="—" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card2Brush}" CornerRadius="7" Padding="9,5" Margin="0,0,7,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TetherLabel" Text="تترینگ USB: " Foreground="{StaticResource MutedBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="TetherText" Text="خاموش" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="BtnConnect" Style="{StaticResource PrimaryBtn}" Content="اتصال"
                                MinWidth="130" Click="BtnConnect_Click" />
                        <CheckBox x:Name="ChkAuto" Content="اتصال خودکار" Margin="0,10,0,0" HorizontalAlignment="Center"
                                  Checked="ChkAuto_Changed" Unchecked="ChkAuto_Changed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Charts -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,5,10">
                    <StackPanel>
                        <TextBlock x:Name="DownTitle" Text="سرعت دانلود" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="DownValue" Text="0 Mbps" FontSize="24" FontWeight="Bold" Margin="0,4,0,6" />
                        <ctl:SpeedChart x:Name="ChartDown" Height="130" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="UpTitle" Text="سرعت آپلود" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="UpValue" Text="0 Mbps" FontSize="24" FontWeight="Bold" Margin="0,4,0,6" />
                        <ctl:SpeedChart x:Name="ChartUp" Height="130" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Totals -->
            <Border Style="{StaticResource Card}">
                <UniformGrid Columns="4">
                    <StackPanel>
                        <TextBlock x:Name="TotDownLabel" Text="کل دانلود" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="TotDown" Text="0 B" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TotUpLabel" Text="کل آپلود" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="TotUp" Text="0 B" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ConnsLabel" Text="اتصال‌های فعال" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="ConnsCount" Text="0" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ProxyLabel" Text="پراکسی محلی" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="ProxyAddr" Text="—" FontSize="14" Style="{StaticResource Mono}" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Signal mini + quick locks -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,5,10">
                    <StackPanel>
                        <TextBlock x:Name="SignalTitle" Text="سیگنال" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="RatBadge" Text="—" FontSize="21" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="SignalDetail" Text="" Margin="14,4,0,0" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" MaxWidth="330" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="QuickTitle" Text="قفل سریع شبکه" Style="{StaticResource CardTitle}" />
                        <WrapPanel Margin="0,8,0,0">
                            <RadioButton x:Name="Q5gAuto" Style="{StaticResource ChipRadio}" Content="5G خودکار" Click="QuickLock_Click" Tag="5G_AUTO" />
                            <RadioButton x:Name="Q5gOnly" Style="{StaticResource ChipRadio}" Content="فقط 5G" Click="QuickLock_Click" Tag="5G_ONLY" />
                            <RadioButton x:Name="Q4gOnly" Style="{StaticResource ChipRadio}" Content="فقط 4G" Click="QuickLock_Click" Tag="4G_ONLY" />
                            <RadioButton x:Name="Q4gAuto" Style="{StaticResource ChipRadio}" Content="4G خودکار" Click="QuickLock_Click" Tag="4G_AUTO" />
                            <RadioButton x:Name="Q3gOnly" Style="{StaticResource ChipRadio}" Content="فقط 3G" Click="QuickLock_Click" Tag="3G_ONLY" />
                            <RadioButton x:Name="Q2gOnly" Style="{StaticResource ChipRadio}" Content="فقط 2G" Click="QuickLock_Click" Tag="2G_ONLY" />
                        </WrapPanel>
                        <TextBlock x:Name="QuickHint" Text="قفل مود در صفحه «شبکه و دکل» با تأیید کامل انجام می‌شود"
                                   Style="{StaticResource Muted}" FontSize="10.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
