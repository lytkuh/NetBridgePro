<Page x:Class="NetBridge.Windows.Ui.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" Text="لاگ سیستم" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                <ComboBox x:Name="LevelBox" Width="90" Margin="16,0,0,0" SelectionChanged="Level_Changed" SelectedIndex="1">
                    <ComboBoxItem Content="DEBUG" />
                    <ComboBoxItem Content="INFO" />
                    <ComboBoxItem Content="WARN" />
                    <ComboBoxItem Content="ERROR" />
                </ComboBox>
                <CheckBox x:Name="AutoScroll" Content="پیمایش خودکار" IsChecked="True" Margin="16,0,0,0" />
                <Button x:Name="CopyBtn" Content="کپی همه" Margin="16,0,0,0" Click="Copy_Click" />
                <Button x:Name="ClearBtn" Content="پاک‌کردن نمایش" Margin="8,0,0,0" Click="Clear_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11.5"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Page>
