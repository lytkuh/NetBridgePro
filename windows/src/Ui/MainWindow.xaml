<Window x:Class="NetBridge.Windows.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetBridge Pro" Height="800" Width="1280" MinHeight="680" MinWidth="1080"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Variable Display, Vazirmatn, Tahoma">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,12,14">
                    <TextBlock Text="NetBridge Pro" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="SubTitle" Text="تترینگ حرفه‌ای + کنترل دکل" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16">
                    <Border Background="{StaticResource Card2Brush}" CornerRadius="9" Padding="11,9"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotStatus" Width="9" Height="9" Fill="{StaticResource DangerBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusPill" Text="قطع" Margin="7,0,0,0" FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="TransportPill" Text="—" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,6,0,0">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavRadio}" GroupName="nav"
                                 IsChecked="True" Content="داشبورد" Checked="Nav_Checked" Tag="dashboard" />
                    <RadioButton x:Name="NavSignal" Style="{StaticResource NavRadio}" GroupName="nav" Content="سیگنال" Checked="Nav_Checked" Tag="signal" />
                    <RadioButton x:Name="NavNetwork" Style="{StaticResource NavRadio}" GroupName="nav" Content="شبکه و دکل" Checked="Nav_Checked" Tag="network" />
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavRadio}" GroupName="nav" Content="فایروال برنامه‌ها" Checked="Nav_Checked" Tag="apps" />
                    <RadioButton x:Name="NavSpeed" Style="{StaticResource NavRadio}" GroupName="nav" Content="تست سرعت" Checked="Nav_Checked" Tag="speed" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}" GroupName="nav" Content="تنظیمات" Checked="Nav_Checked" Tag="settings" />
                    <RadioButton x:Name="NavLogs" Style="{StaticResource NavRadio}" GroupName="nav" Content="لاگ‌ها" Checked="Nav_Checked" Tag="logs" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavRadio}" GroupName="nav" Content="درباره ما" Checked="Nav_Checked" Tag="about" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <!-- Pages must live in a Frame: WPF forbids Page inside a plain ContentControl -->
        <Frame x:Name="PageHost" Grid.Column="1" Margin="18,14,18,10"
               NavigationUIVisibility="Hidden" Focusable="False" />
    </Grid>
</Window>
